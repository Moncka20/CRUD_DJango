# Usa SQLite por defecto para desarrollo local.
# Para MariaDB, define DB_ENGINE=mysql y completa estas variables.
DB_ENGINE=mysql
DB_NAME=biblioteca_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
